<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="InfraDroneDesktop.Views.StoryModeView">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,10">
      <TextBlock Text="📖 Story Mode -- The 910/942 Near-Miss" FontSize="16" FontWeight="Bold" Foreground="White"/>
      <TextBlock Name="StepCounter" Text="Step 1 of 8" FontSize="11" Foreground="#94a3b8"/>
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Background="#131f2e" CornerRadius="8" Padding="14" Margin="0,10,0,0"
            BorderBrush="#1e3a5f" BorderThickness="0.5">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Grid.Column="0" Content="◀ Previous" Click="OnPrevious"
                Background="#1e3a5f" Foreground="#e2e8f0" BorderBrush="#3E8E7E"
                BorderThickness="0.5" Padding="14,8" CornerRadius="6" FontSize="12"/>
        <TextBlock Grid.Column="1" Name="NarrativeText" FontSize="14" Foreground="White"
                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="16,0"/>
        <Button Grid.Column="2" Content="Next ▶" Click="OnNext"
                Background="#0d3d2e" Foreground="#0d9e75" BorderBrush="#0d9e75"
                BorderThickness="0.5" Padding="14,8" CornerRadius="6" FontSize="12"/>
      </Grid>
    </Border>

    <Border Background="#0a0f18" CornerRadius="8">
      <Image Name="StoryImage" Stretch="Uniform" Margin="8"/>
    </Border>
  </DockPanel>
</UserControl>
