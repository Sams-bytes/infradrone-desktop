<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="InfraDroneDesktop.Views.ProvinceStudyView">
  <Grid RowDefinitions="Auto,*">
    <!-- Header: study title, last update, actions -->
    <StackPanel Orientation="Horizontal" Margin="12,10,12,6" Spacing="12">
      <TextBlock x:Name="HeaderText" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                 Text="Province study"/>
      <TextBlock x:Name="GeneratedText" Opacity="0.6" VerticalAlignment="Center" FontSize="12"/>
      <Button Content="Reload" Click="OnReload"/>
      <Button Content="Open study folder" Click="OnOpenFolder"/>
    </StackPanel>
    <!-- One tab per part of the study; built from manifest.json -->
    <TabControl Grid.Row="1" x:Name="Tabs" Margin="8,0,8,8"/>
  </Grid>
</UserControl>
