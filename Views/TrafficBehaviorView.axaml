<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="InfraDroneDesktop.Views.TrafficBehaviorView">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="10">
      <TextBlock Text="🚶 Traffic Behavior Analysis" FontSize="16" FontWeight="Bold" Foreground="White"/>
      <TextBlock Text="Pedestrian/vehicle interaction detection using real drone-tracked trajectory data (openDD dataset, CC BY-ND 4.0, EU Horizon 2020 L3Pilot project). Prototype methodology for the Groningen crossing behavior study -- roundabout data, not yet a signalized crossing."
                 FontSize="11" Foreground="#94a3b8" TextWrapping="Wrap"/>

      <!-- Trajectory Map -->
      <Border Background="#131f2e" CornerRadius="8" Padding="10"
              BorderBrush="#3E8E7E" BorderThickness="0.5">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="🗺️ Trajectory Map — Real Aerial Overlay"
                       FontSize="11" FontWeight="Bold" Foreground="#3E8E7E"/>
            <Button Grid.Column="1" Content="↗ Full screen" Click="OnOpenTrajectoryMap"
                    Background="#0d3d2e" Foreground="#3E8E7E"
                    BorderBrush="#3E8E7E" BorderThickness="0.5"
                    Padding="6,3" CornerRadius="4" FontSize="10"/>
          </Grid>
          <Image Name="TrajectoryMapImage" Stretch="Uniform" MaxHeight="400" IsVisible="False"/>
          <TextBlock Name="TrajectoryMapStatus" Text="Not loaded." FontSize="10" Foreground="#64748b"/>
        </StackPanel>
      </Border>

      <!-- Near-Miss Detection -->
      <Border Background="#131f2e" CornerRadius="8" Padding="10"
              BorderBrush="#dc2626" BorderThickness="0.5">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="⚠️ Near-Miss Detection — Time-To-Collision Analysis"
                       FontSize="11" FontWeight="Bold" Foreground="#dc2626"/>
            <Button Grid.Column="1" Content="↗ Full screen" Click="OnOpenNearMiss"
                    Background="#3d0d0d" Foreground="#dc2626"
                    BorderBrush="#dc2626" BorderThickness="0.5"
                    Padding="6,3" CornerRadius="4" FontSize="10"/>
          </Grid>
          <Image Name="NearMissImage" Stretch="Uniform" MaxHeight="340" IsVisible="False"/>
          <TextBlock Name="NearMissStatus" Text="Not loaded." FontSize="10" Foreground="#64748b"/>
        </StackPanel>
      </Border>

      <!-- Pedestrian Behavior Profile -->
      <Border Background="#131f2e" CornerRadius="8" Padding="10"
              BorderBrush="#eab308" BorderThickness="0.5">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="📈 Pedestrian Behavior Profile — Reaction Signature"
                       FontSize="11" FontWeight="Bold" Foreground="#eab308"/>
            <Button Grid.Column="1" Content="↗ Full screen" Click="OnOpenBehaviorProfile"
                    Background="#3d2e0d" Foreground="#eab308"
                    BorderBrush="#eab308" BorderThickness="0.5"
                    Padding="6,3" CornerRadius="4" FontSize="10"/>
          </Grid>
          <Image Name="BehaviorProfileImage" Stretch="Uniform" MaxHeight="340" IsVisible="False"/>
          <TextBlock Name="BehaviorProfileStatus" Text="Not loaded." FontSize="10" Foreground="#64748b"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
