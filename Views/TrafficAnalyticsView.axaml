<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="InfraDroneDesktop.Views.TrafficAnalyticsView">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="10">
      <TextBlock Text="📊 Traffic Analytics" FontSize="16" FontWeight="Bold" Foreground="White"/>
      <TextBlock Text="12 analyses built from real drone-tracked trajectory data (openDD rdb1, CC BY-ND 4.0). Prototype methodology -- roundabout data, adjust per actual Groningen crossing requirements."
                 FontSize="11" Foreground="#94a3b8" TextWrapping="Wrap"/>

      <!-- Composite Safety Score, headline summary -->
      <Border Background="#131f2e" CornerRadius="8" Padding="10" BorderBrush="#0d9e75" BorderThickness="1">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="🎯 Composite Safety Score (transparent, weighted index)" FontSize="12" FontWeight="Bold" Foreground="#0d9e75"/>
            <Button Grid.Column="1" Content="↗" Click="OnOpenSafetyScore" Background="#0d3d2e" Foreground="#0d9e75" BorderBrush="#0d9e75" BorderThickness="0.5" Padding="6,3" CornerRadius="4" FontSize="10"/>
          </Grid>
          <Image Name="SafetyScoreImage" Stretch="Uniform" MaxHeight="360" IsVisible="False"/>
          <TextBlock Name="SafetyScoreStatus" Text="Not loaded." FontSize="10" Foreground="#64748b"/>
        </StackPanel>
      </Border>

      <!-- ===== SAFETY & CONFLICT ===== -->
      <Expander Header="⚠️ Safety &amp; Conflict" IsExpanded="True" Foreground="White">
        <StackPanel Spacing="8" Margin="0,8,0,0">
          <Border Background="#131f2e" CornerRadius="8" Padding="10" BorderBrush="#dc2626" BorderThickness="0.5">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Near-Miss Hotspot Map" FontSize="11" FontWeight="Bold" Foreground="#dc2626"/>
                <Button Grid.Column="1" Content="↗" Click="OnOpenNearMissHotspot" Background="#3d0d0d" Foreground="#dc2626" BorderBrush="#dc2626" BorderThickness="0.5" Padding="6,3" CornerRadius="4" FontSize="10"/>
              </Grid>
              <Image Name="NearMissHotspotImage" Stretch="Uniform" MaxHeight="320" IsVisible="False"/>
              <TextBlock Name="NearMissHotspotStatus" Text="Not loaded." FontSize="10" Foreground="#64748b"/>
            </StackPanel>
          </Border>
          <Border Background="#131f2e" CornerRadius="8" Padding="10" BorderBrush="#dc2626" BorderThickness="0.5">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Harsh Braking Distribution" FontSize="11" FontWeight="Bold" Foreground="#dc2626"/>
                <Button Grid.Column="1" Content="↗" Click="OnOpenHarshBraking" Background="#3d0d0d" Foreground="#dc2626" BorderBrush="#dc2626" BorderThickness="0.5" Padding="6,3" CornerRadius="4" FontSize="10"/>
              </Grid>
              <Image Name="HarshBrakingImage" Stretch="Uniform" MaxHeight="320" IsVisible="False"/>
              <TextBlock Name="HarshBrakingStatus" Text="Not loaded." FontSize="10" Foreground="#64748b"/>
            </StackPanel>
          </Border>
          <Border Background="#131f2e" CornerRadius="8" Padding="10" BorderBrush="#dc2626" BorderThickness="0.5">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Yielding Behavior" FontSize="11" FontWeight="Bold" Foreground="#dc2626"/>
                <Button Grid.Column="1" Content="↗" Click="OnOpenYielding" Background="#3d0d0d" Foreground="#dc2626" BorderBrush="#dc2626" BorderThickness="0.5" Padding="6,3" CornerRadius="4" FontSize="10"/>
              </Grid>
              <Image Name="YieldingImage" Stretch="Uniform" MaxHeight="320" IsVisible="False"/>
              <TextBlock Name="YieldingStatus" Text="Not loaded." FontSize="10" Foreground="#64748b"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Expander>

      <!-- ===== GAP ACCEPTANCE & FLOW ===== -->
      <Expander Header="🔀 Gap Acceptance &amp; Flow" IsExpanded="False" Foreground="White">
        <StackPanel Spacing="8" Margin="0,8,0,0">
          <Border Background="#131f2e" CornerRadius="8" Padding="10" BorderBrush="#eab308" BorderThickness="0.5">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Roundabout Entry Gap-Acceptance" FontSize="11" FontWeight="Bold" Foreground="#eab308"/>
                <Button Grid.Column="1" Content="↗" Click="OnOpenGapAcceptance" Background="#3d2e0d" Foreground="#eab308" BorderBrush="#eab308" BorderThickness="0.5" Padding="6,3" CornerRadius="4" FontSize="10"/>
              </Grid>
              <Image Name="GapAcceptanceImage" Stretch="Uniform" MaxHeight="320" IsVisible="False"/>
              <TextBlock Name="GapAcceptanceStatus" Text="Not loaded." FontSize="10" Foreground="#64748b"/>
            </StackPanel>
          </Border>
          <Border Background="#131f2e" CornerRadius="8" Padding="10" BorderBrush="#eab308" BorderThickness="0.5">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Vehicle Time Headway" FontSize="11" FontWeight="Bold" Foreground="#eab308"/>
                <Button Grid.Column="1" Content="↗" Click="OnOpenTimeHeadway" Background="#3d2e0d" Foreground="#eab308" BorderBrush="#eab308" BorderThickness="0.5" Padding="6,3" CornerRadius="4" FontSize="10"/>
              </Grid>
              <Image Name="TimeHeadwayImage" Stretch="Uniform" MaxHeight="320" IsVisible="False"/>
              <TextBlock Name="TimeHeadwayStatus" Text="Not loaded." FontSize="10" Foreground="#64748b"/>
            </StackPanel>
          </Border>
          <Border Background="#131f2e" CornerRadius="8" Padding="10" BorderBrush="#eab308" BorderThickness="0.5">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Entry Queue/Wait Time" FontSize="11" FontWeight="Bold" Foreground="#eab308"/>
                <Button Grid.Column="1" Content="↗" Click="OnOpenQueueWait" Background="#3d2e0d" Foreground="#eab308" BorderBrush="#eab308" BorderThickness="0.5" Padding="6,3" CornerRadius="4" FontSize="10"/>
              </Grid>
              <Image Name="QueueWaitImage" Stretch="Uniform" MaxHeight="320" IsVisible="False"/>
              <TextBlock Name="QueueWaitStatus" Text="Not loaded." FontSize="10" Foreground="#64748b"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Expander>

      <!-- ===== PEDESTRIAN BEHAVIOR ===== -->
      <Expander Header="🚶 Pedestrian Behavior" IsExpanded="False" Foreground="White">
        <StackPanel Spacing="8" Margin="0,8,0,0">
          <Border Background="#131f2e" CornerRadius="8" Padding="10" BorderBrush="#3E8E7E" BorderThickness="0.5">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Hesitation Time (relative to own pace)" FontSize="11" FontWeight="Bold" Foreground="#3E8E7E"/>
                <Button Grid.Column="1" Content="↗" Click="OnOpenHesitation" Background="#0d3d2e" Foreground="#3E8E7E" BorderBrush="#3E8E7E" BorderThickness="0.5" Padding="6,3" CornerRadius="4" FontSize="10"/>
              </Grid>
              <Image Name="HesitationImage" Stretch="Uniform" MaxHeight="320" IsVisible="False"/>
              <TextBlock Name="HesitationStatus" Text="Not loaded." FontSize="10" Foreground="#64748b"/>
            </StackPanel>
          </Border>
          <Border Background="#131f2e" CornerRadius="8" Padding="10" BorderBrush="#3E8E7E" BorderThickness="0.5">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Acceleration-Spike Detection (companion metric)" FontSize="11" FontWeight="Bold" Foreground="#3E8E7E"/>
                <Button Grid.Column="1" Content="↗" Click="OnOpenAccelSpike" Background="#0d3d2e" Foreground="#3E8E7E" BorderBrush="#3E8E7E" BorderThickness="0.5" Padding="6,3" CornerRadius="4" FontSize="10"/>
              </Grid>
              <Image Name="AccelSpikeImage" Stretch="Uniform" MaxHeight="320" IsVisible="False"/>
              <TextBlock Name="AccelSpikeStatus" Text="Not loaded." FontSize="10" Foreground="#64748b"/>
            </StackPanel>
          </Border>
          <Border Background="#131f2e" CornerRadius="8" Padding="10" BorderBrush="#3E8E7E" BorderThickness="0.5">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Path Deviation Index" FontSize="11" FontWeight="Bold" Foreground="#3E8E7E"/>
                <Button Grid.Column="1" Content="↗" Click="OnOpenPathDeviation" Background="#0d3d2e" Foreground="#3E8E7E" BorderBrush="#3E8E7E" BorderThickness="0.5" Padding="6,3" CornerRadius="4" FontSize="10"/>
              </Grid>
              <Image Name="PathDeviationImage" Stretch="Uniform" MaxHeight="320" IsVisible="False"/>
              <TextBlock Name="PathDeviationStatus" Text="Not loaded." FontSize="10" Foreground="#64748b"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Expander>

      <!-- ===== SPATIAL & COMPOSITION ===== -->
      <Expander Header="🗺️ Spatial &amp; Composition" IsExpanded="False" Foreground="White">
        <StackPanel Spacing="8" Margin="0,8,0,0">
          <Border Background="#131f2e" CornerRadius="8" Padding="10" BorderBrush="#8b5cf6" BorderThickness="0.5">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Speed Heatmap" FontSize="11" FontWeight="Bold" Foreground="#8b5cf6"/>
                <Button Grid.Column="1" Content="↗" Click="OnOpenSpeedHeatmap" Background="#2e0d3d" Foreground="#8b5cf6" BorderBrush="#8b5cf6" BorderThickness="0.5" Padding="6,3" CornerRadius="4" FontSize="10"/>
              </Grid>
              <Image Name="SpeedHeatmapImage" Stretch="Uniform" MaxHeight="320" IsVisible="False"/>
              <TextBlock Name="SpeedHeatmapStatus" Text="Not loaded." FontSize="10" Foreground="#64748b"/>
            </StackPanel>
          </Border>
          <Border Background="#131f2e" CornerRadius="8" Padding="10" BorderBrush="#8b5cf6" BorderThickness="0.5">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Desire Paths vs. Official Lane Geometry" FontSize="11" FontWeight="Bold" Foreground="#8b5cf6"/>
                <Button Grid.Column="1" Content="↗" Click="OnOpenDesirePaths" Background="#2e0d3d" Foreground="#8b5cf6" BorderBrush="#8b5cf6" BorderThickness="0.5" Padding="6,3" CornerRadius="4" FontSize="10"/>
              </Grid>
              <Image Name="DesirePathsImage" Stretch="Uniform" MaxHeight="320" IsVisible="False"/>
              <TextBlock Name="DesirePathsStatus" Text="Not loaded." FontSize="10" Foreground="#64748b"/>
            </StackPanel>
          </Border>
          <Border Background="#131f2e" CornerRadius="8" Padding="10" BorderBrush="#8b5cf6" BorderThickness="0.5">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Traffic Volume Over Time" FontSize="11" FontWeight="Bold" Foreground="#8b5cf6"/>
                <Button Grid.Column="1" Content="↗" Click="OnOpenTrafficVolume" Background="#2e0d3d" Foreground="#8b5cf6" BorderBrush="#8b5cf6" BorderThickness="0.5" Padding="6,3" CornerRadius="4" FontSize="10"/>
              </Grid>
              <Image Name="TrafficVolumeImage" Stretch="Uniform" MaxHeight="320" IsVisible="False"/>
              <TextBlock Name="TrafficVolumeStatus" Text="Not loaded." FontSize="10" Foreground="#64748b"/>
            </StackPanel>
          </Border>
          <Border Background="#131f2e" CornerRadius="8" Padding="10" BorderBrush="#8b5cf6" BorderThickness="0.5">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Object Size Cross-Check" FontSize="11" FontWeight="Bold" Foreground="#8b5cf6"/>
                <Button Grid.Column="1" Content="↗" Click="OnOpenObjectSize" Background="#2e0d3d" Foreground="#8b5cf6" BorderBrush="#8b5cf6" BorderThickness="0.5" Padding="6,3" CornerRadius="4" FontSize="10"/>
              </Grid>
              <Image Name="ObjectSizeImage" Stretch="Uniform" MaxHeight="320" IsVisible="False"/>
              <TextBlock Name="ObjectSizeStatus" Text="Not loaded." FontSize="10" Foreground="#64748b"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
