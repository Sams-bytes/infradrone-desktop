<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:maps="clr-namespace:Mapsui.UI.Avalonia;assembly=Mapsui.UI.Avalonia"
             x:Class="InfraDroneDesktop.Views.FlightView">
  <Grid RowDefinitions="Auto,*,Auto,Auto">

    <!-- Toolbar -->
    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Background="#0f1923">
    <StackPanel Orientation="Horizontal" Spacing="6"
                Background="#0f1923" Margin="0"
                HorizontalAlignment="Left">
      <StackPanel.Styles>
        <Style Selector="Button">
          <Setter Property="Padding" Value="10,6"/>
          <Setter Property="FontSize" Value="11"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="CornerRadius" Value="6"/>
          <Setter Property="BorderThickness" Value="0.5"/>
          <Setter Property="Margin" Value="2,4"/>
        </Style>
      </StackPanel.Styles>
      <Button Name="BtnArm" Background="#3d1515" Foreground="#ef4444"
              BorderBrush="#ef4444" Click="OnArm">ARM</Button>
      <Button Name="BtnDisarm" Background="#1a2637" Foreground="#94a3b8"
              BorderBrush="#2d3f52" Click="OnDisarm">DISARM</Button>
      <Separator Width="1" Background="#2d3f52" Margin="4,6"/>
      <Button Name="BtnTakeoff" Background="#0d3d2e" Foreground="#0d9e75"
              BorderBrush="#0d9e75" Click="OnTakeoff">TAKEOFF</Button>
      <Button Name="BtnLand" Background="#1a2637" Foreground="#94a3b8"
              BorderBrush="#2d3f52" Click="OnLand">LAND</Button>
      <Button Name="BtnRtl" Background="#3d2e0d" Foreground="#f59e0b"
              BorderBrush="#f59e0b" Click="OnRtl">RTL</Button>
      <Separator Width="1" Background="#2d3f52" Margin="4,6"/>
      <Button Name="BtnLoiter" Background="#1a2637" Foreground="#94a3b8"
              BorderBrush="#2d3f52" Click="OnLoiter">LOITER</Button>
      <Button Name="BtnGuided" Background="#1a2637" Foreground="#94a3b8"
              BorderBrush="#2d3f52" Click="OnGuided">GUIDED</Button>
      <Button Name="BtnAuto" Background="#1a2637" Foreground="#94a3b8"
              BorderBrush="#2d3f52" Click="OnAuto">AUTO</Button>
      <Separator Width="1" Background="#2d3f52" Margin="4,6"/>
      <Button Name="BtnMapToggle" Background="#1a2637" Foreground="#94a3b8"
              BorderBrush="#2d3f52" Click="OnMapToggle">🗺 Street</Button>
      <TextBox Name="LocationSearchBox" Width="180" FontSize="11" Watermark="Search address/road..."
               Background="#0f1923" Foreground="#e2e8f0" BorderBrush="#2d3f52"
               KeyDown="OnLocationSearchKeyDown"/>
      <Button Name="BtnVoiceCommand" Content="🎤 Voice" Click="OnVoiceCommand"
              Background="#1a2637" Foreground="#94a3b8" BorderBrush="#2d3f52" BorderThickness="0.5" Padding="8,6" CornerRadius="6"/>
      <Separator Width="1" Background="#2d3f52" Margin="4,6"/>
      <Button Name="BtnLocationSearch" Content="🔍" Click="OnLocationSearch"
              Background="#1a2637" Foreground="#94a3b8" BorderBrush="#2d3f52"/>
      <Separator Width="1" Background="#2d3f52" Margin="4,6"/>
      <Button Name="BtnInfraLayers" Background="#1a2637" Foreground="#94a3b8"
              BorderBrush="#2d3f52">
        🏛 Infra Layers
        <Button.Flyout>
          <Flyout Placement="Bottom">
            <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="6" Margin="8" MinWidth="220">

              <TextBlock Text="🛣 ROAD &amp; PAVEMENT" FontSize="10" FontWeight="Bold"
                         Foreground="#0d9e75" LetterSpacing="1" Margin="0,0,0,2"/>
              <CheckBox Name="ChkGroningenRoads" Content="🏛 Roads (paving)" FontSize="12"
                        Foreground="#e2e8f0" IsCheckedChanged="OnGroningenRoadsToggled"/>
              <CheckBox Name="ChkGroningenCracking" Content="🩹 Cracking (official)" FontSize="12"
                        Foreground="#e2e8f0" IsCheckedChanged="OnGroningenCrackingToggled"/>
              <CheckBox Name="ChkGroningenRaveling" Content="🪨 Raveling (official)" FontSize="12"
                        Foreground="#e2e8f0" IsCheckedChanged="OnGroningenRavelingToggled"/>
              <CheckBox Name="ChkGroningenUnevenness" Content="〰 Unevenness (official)" FontSize="12"
                        Foreground="#e2e8f0" IsCheckedChanged="OnGroningenUnevennessToggled"/>
              <CheckBox Name="ChkGroningenRutting" Content="🛞 Rutting (official)" FontSize="12"
                        Foreground="#e2e8f0" IsCheckedChanged="OnGroningenRuttingToggled"/>
              <CheckBox Name="ChkGroningenLongEvenness" Content="📏 Long. evenness (official)" FontSize="12"
                        Foreground="#e2e8f0" IsCheckedChanged="OnGroningenLongEvennessToggled"/>
              <CheckBox Name="ChkBermcondities" Content="🌾 Verge conditions" FontSize="12"
                        Foreground="#e2e8f0" IsCheckedChanged="OnBermconditiesToggled"/>

              <TextBlock Text="🌉 STRUCTURES" FontSize="10" FontWeight="Bold"
                         Foreground="#3b82f6" LetterSpacing="1" Margin="0,10,0,2"/>
              <CheckBox Name="ChkGroningenBridges" Content="🌉 Bridges" FontSize="12"
                        Foreground="#e2e8f0" IsCheckedChanged="OnGroningenBridgesToggled"/>
              <CheckBox Name="ChkGroningenGuardrails" Content="🚧 Guardrails" FontSize="12"
                        Foreground="#e2e8f0" IsCheckedChanged="OnGroningenGuardrailsToggled"/>
              <CheckBox Name="ChkDuikers" Content="🕳 Culverts" FontSize="12"
                        Foreground="#e2e8f0" IsCheckedChanged="OnDuikersToggled"/>
              <CheckBox Name="ChkGeluidsschermen" Content="🔇 Noise barriers" FontSize="12"
                        Foreground="#e2e8f0" IsCheckedChanged="OnGeluidsschermenToggled"/>

              <TextBlock Text="🚦 TRAFFIC &amp; SAFETY" FontSize="10" FontWeight="Bold"
                         Foreground="#eab308" LetterSpacing="1" Margin="0,10,0,2"/>
              <CheckBox Name="ChkFietspaden" Content="🚲 Cycle paths" FontSize="12"
                        Foreground="#e2e8f0" IsCheckedChanged="OnFietspadenToggled"/>
              <CheckBox Name="ChkCameramasten" Content="📷 Camera masts" FontSize="12"
                        Foreground="#e2e8f0" IsCheckedChanged="OnCameramastenToggled"/>
              <CheckBox Name="ChkGladheid" Content="❄ Ice sensors" FontSize="12"
                        Foreground="#e2e8f0" IsCheckedChanged="OnGladheidToggled"/>

              <TextBlock Text="🇳🇱 NATIONAL DATA" FontSize="10" FontWeight="Bold"
                         Foreground="#a855f7" LetterSpacing="1" Margin="0,10,0,2"/>
              <CheckBox Name="ChkBagBuildings" Content="🏢 Buildings (BAG)" FontSize="12"
                        Foreground="#e2e8f0" IsCheckedChanged="OnBagBuildingsToggled"/>
              <CheckBox Name="ChkAhnElevation" Content="🌋 Elevation (AHN)" FontSize="12"
                        Foreground="#e2e8f0" IsCheckedChanged="OnAhnElevationToggled"/>
              <CheckBox Name="ChkTrafficSigns" Content="🚸 Traffic signs (large, may be slow)" FontSize="12"
                        Foreground="#e2e8f0" IsCheckedChanged="OnTrafficSignsToggled"/>

              <TextBlock Text="🛰 SATELLITE &amp; EU" FontSize="10" FontWeight="Bold"
                         Foreground="#22c55e" LetterSpacing="1" Margin="0,10,0,2"/>
              <CheckBox Name="ChkSentinelNdvi" Content="🌱 NDVI (Sentinel-2)" FontSize="12"
                        Foreground="#e2e8f0" IsCheckedChanged="OnSentinelNdviToggled"/>

            </StackPanel>
            </ScrollViewer>
          </Flyout>
        </Button.Flyout>
      </Button>
      <Separator Width="1" Background="#2d3f52" Margin="4,6"/>
      <Button Name="BtnAddWpToggle" Background="#1a2637" Foreground="#94a3b8"
              BorderBrush="#2d3f52" Click="OnAddWpToggle">📍 Add WP: OFF</Button>
      <Button Name="BtnClearWp" Background="#3d1515" Foreground="#ef4444"
              BorderBrush="#ef4444" Click="OnClearWaypoints">🗑 Clear WP</Button>
      <Button Name="BtnUploadMission" Background="#0d3d2e" Foreground="#0d9e75"
              BorderBrush="#0d9e75" Click="OnUploadMission">⬆ Upload Mission</Button>
      <Button Name="BtnViewFlightLog" Background="#1a2637" Foreground="#94a3b8"
              BorderBrush="#2d3f52" Click="OnViewFlightLog">📋 View Flight Log</Button>
      <TextBlock Text="Speed:" FontSize="11" Foreground="#94a3b8" VerticalAlignment="Center" Margin="6,0,4,0"/>
      <TextBox Name="SpeedInput" Width="45" FontSize="11" Watermark="m/s"
                Background="#f8fafc" Foreground="#0f1923" BorderBrush="#0d9e75"
                BorderThickness="1.5" FontWeight="Bold" Padding="6,4" VerticalContentAlignment="Center"/>
      <TextBlock Name="MissionStatusText" Text="" FontSize="11" Foreground="#64748b"
                 VerticalAlignment="Center" Margin="10,0,0,0"/>
    </StackPanel>
    </ScrollViewer>

    <!-- Map -->
    <maps:MapControl Grid.Row="1" Name="MapControl"/>
    <Border Name="GroningenInfoCard" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
            Margin="16" MaxWidth="320" MaxHeight="500" Background="#e0131f2e" CornerRadius="8" Padding="12"
            BorderBrush="#3b82f6" BorderThickness="1" IsVisible="False">
      <Grid RowDefinitions="Auto,*,Auto,Auto">
        <TextBlock Grid.Row="0" Text="🏛 Groningen Road Asset" FontSize="11" FontWeight="Bold" Foreground="#3b82f6" Margin="0,0,0,4"/>
        <ScrollViewer Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto">
          <TextBlock Name="GroningenInfoText" Text="" FontSize="11" Foreground="#e2e8f0" TextWrapping="Wrap" FontFamily="Consolas"/>
        </ScrollViewer>
        <Border Grid.Row="2" Background="#1a2637" CornerRadius="6" Padding="8" BorderBrush="#2d3f52" BorderThickness="0.5" Margin="0,8,0,0">
          <StackPanel Spacing="6">
            <TextBlock Text="Generate Maintenance Ticket" FontSize="10" FontWeight="Bold" Foreground="#94a3b8"/>
            <TextBox Name="TicketDescriptionBox" Watermark="Describe the defect found here..."
                      FontSize="11" FontWeight="Bold" Background="#0f1923" Foreground="#ef4444"
                      CaretBrush="#ef4444" BorderBrush="#0d9e75" BorderThickness="1.5" AcceptsReturn="True" Height="50"/>
            <ComboBox Name="TicketSeverityCombo" SelectedIndex="1" FontSize="11">
              <ComboBoxItem Content="Low"/>
              <ComboBoxItem Content="Medium"/>
              <ComboBoxItem Content="High"/>
              <ComboBoxItem Content="Critical"/>
            </ComboBox>
            <Button Name="BtnGenerateTicket" Content="📋 Generate Ticket" Click="OnGenerateTicket"
                    Background="#0d3d2e" Foreground="#0d9e75" BorderBrush="#0d9e75"
                    BorderThickness="0.5" Padding="8,5" CornerRadius="6" FontSize="11" HorizontalAlignment="Stretch"/>
            <TextBlock Name="TicketStatusText" Text="" FontSize="10" Foreground="#64748b" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Grid.Row="3" Background="#1a2637" CornerRadius="6" Padding="8" BorderBrush="#f59e0b" BorderThickness="0.5" Margin="0,8,0,0">
          <StackPanel Spacing="6">
            <Button Name="BtnPredictTrend" Content="📊 Predict Trend (from real CROW data)" Click="OnPredictTrend"
                    Background="#3d2e0d" Foreground="#f59e0b" BorderBrush="#f59e0b"
                    BorderThickness="0.5" Padding="8,5" CornerRadius="6" FontSize="11" HorizontalAlignment="Stretch"/>
            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
              <TextBlock Name="TrendText" Text="" FontSize="10" Foreground="#e2e8f0" TextWrapping="Wrap" FontFamily="Consolas"/>
            </ScrollViewer>
            <Button Name="BtnViewHealthPassport" Content="🪪 View Health Passport" Click="OnViewHealthPassport"
                    Background="#2e0d3d" Foreground="#a855f7" BorderBrush="#a855f7"
                    BorderThickness="0.5" Padding="8,5" CornerRadius="6" FontSize="11" HorizontalAlignment="Stretch"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
    <Border Name="NdviLegendCard" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="16,16,16,220" Background="#e0131f2e" CornerRadius="8" Padding="10"
            BorderBrush="#22c55e" BorderThickness="1" IsVisible="False" MaxWidth="180">
      <StackPanel Name="NdviLegendPanel" Spacing="2">
        <TextBlock Text="NDVI Legend" FontSize="12" FontWeight="Bold" Foreground="#22c55e" Margin="0,0,0,4"/>
      </StackPanel>
    </Border>
    <Border Name="AhnLegendCard" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="16" Background="#e0131f2e" CornerRadius="8" Padding="10"
            BorderBrush="#3b82f6" BorderThickness="1" IsVisible="False" MaxWidth="220" MaxHeight="200">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="AHN Elevation Legend (m)" FontSize="12" FontWeight="Bold" Foreground="#3b82f6" Margin="0,0,0,6"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Image Name="AhnLegendImage" Stretch="Uniform" VerticalAlignment="Top"/>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"
            Background="#c0131f2e" CornerRadius="6" Padding="10,6" BorderBrush="#3b82f6" BorderThickness="1">
      <TextBlock Name="AdsbCountText" Text="Loading ADS-B..." Foreground="#3b82f6" FontSize="12" FontWeight="Bold"/>
    </Border>
    <Border Name="StatusBanner" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="0,64,0,0" MinWidth="320" MaxWidth="520"
            Background="#e0141e2b" CornerRadius="10" Padding="0"
            BorderBrush="#1e293b" BorderThickness="1" IsVisible="False"
            BoxShadow="0 4 16 0 #40000000">
      <Grid ColumnDefinitions="4,Auto,*">
        <Border Name="StatusBannerAccent" Grid.Column="0" Background="#f59e0b" CornerRadius="10,0,0,10"/>
        <TextBlock Name="StatusBannerIcon" Grid.Column="1" Text="⚠" FontSize="16"
                    Foreground="#f59e0b" VerticalAlignment="Center" Margin="12,0,8,0"/>
        <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,9,14,9" VerticalAlignment="Center">
          <TextBlock Name="StatusBannerLabel" Text="VEHICLE STATUS" FontSize="9" FontWeight="Bold"
                      Foreground="#94a3b8" LetterSpacing="1"/>
          <TextBlock Name="StatusBannerText" Text="" Foreground="#f1f5f9" FontSize="12.5"
                      FontWeight="Medium" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Attitude indicator overlay -->
    <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,16,182,16"
            Width="150" Height="150" CornerRadius="75" ClipToBounds="True"
            BorderBrush="#3E8E7E" BorderThickness="1.5">
      <Grid>
        <!-- Rotating/shifting sky-ground plane, driven by roll (rotation) and pitch (offset) -->
        <Canvas Name="AttitudeCanvas" Width="300" Height="300"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5">
          <Canvas.RenderTransform>
            <RotateTransform Angle="0"/>
          </Canvas.RenderTransform>
          <Rectangle Name="SkyRect" Canvas.Left="-150" Canvas.Top="-300" Width="300" Height="300" Fill="#2563eb"/>
          <Rectangle Name="GroundRect" Canvas.Left="-150" Canvas.Top="0" Width="300" Height="300" Fill="#65a30d"/>
          <Line StartPoint="-150,0" EndPoint="150,0" Stroke="White" StrokeThickness="2"/>
        </Canvas>

        <!-- Fixed aircraft reference symbol (gull-wing bracket), stays centered always -->
        <Canvas Width="80" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Line StartPoint="0,10" EndPoint="28,10" Stroke="#eab308" StrokeThickness="3"/>
          <Line StartPoint="52,10" EndPoint="80,10" Stroke="#eab308" StrokeThickness="3"/>
          <Line StartPoint="28,10" EndPoint="34,16" Stroke="#eab308" StrokeThickness="3"/>
          <Line StartPoint="52,10" EndPoint="46,16" Stroke="#eab308" StrokeThickness="3"/>
          <Ellipse Canvas.Left="36" Canvas.Top="6" Width="8" Height="8" Fill="#eab308"/>
        </Canvas>

        <!-- Pitch ladder marks -->
        <TextBlock Text="10" Foreground="White" FontSize="10" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-60,-30,0,0"/>
        <TextBlock Text="10" Foreground="White" FontSize="10" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="60,-30,0,0"/>
        <TextBlock Text="-10" Foreground="#dc2626" FontSize="10" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-60,30,0,0"/>
        <TextBlock Text="-10" Foreground="#dc2626" FontSize="10" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="60,30,0,0"/>

        <Border Background="#0f1923" CornerRadius="4" Padding="6,2"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8">
          <TextBlock Name="AttitudeText" Text="R:0° P:0°" Foreground="#0d9e75"
                     FontFamily="Consolas" FontSize="10" FontWeight="Bold"/>
        </Border>
      </Grid>
    </Border>

    <!-- Compass rose overlay -->
    <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"
            Width="150" Height="150" CornerRadius="75" Background="#c0131f2e"
            BorderBrush="#3E8E7E" BorderThickness="1.5">
      <Grid>
        <TextBlock Text="N" Foreground="White" FontWeight="Bold" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/>
        <TextBlock Text="S" Foreground="#94a3b8" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
        <TextBlock Text="E" Foreground="#94a3b8" FontSize="13"
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock Text="W" Foreground="#94a3b8" FontSize="13"
                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"/>

        <Path Name="CompassNeedle" Fill="#dc2626" Stroke="White" StrokeThickness="0.5"
              Data="M 0,-45 L 8,10 L 0,0 L -8,10 Z"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5">
          <Path.RenderTransform>
            <RotateTransform Angle="0"/>
          </Path.RenderTransform>
        </Path>

        <Border Background="#0f1923" CornerRadius="4" Padding="6,2"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Name="CompassHeadingText" Text="---°" Foreground="#0d9e75"
                     FontFamily="Consolas" FontSize="13" FontWeight="Bold"/>
        </Border>
      </Grid>
    </Border>

    <!-- HUD strip -->
    <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*,*,*,*"
          Background="#0f1923" Height="54">
      <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="ALTITUDE" FontSize="8" Foreground="#4a5568" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Name="HudAlt" Text="—" FontSize="16" Foreground="#e2e8f0" FontFamily="Consolas" HorizontalAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="SPEED" FontSize="8" Foreground="#4a5568" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Name="HudSpeed" Text="—" FontSize="16" Foreground="#e2e8f0" FontFamily="Consolas" HorizontalAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="HEADING" FontSize="8" Foreground="#4a5568" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Name="HudHeading" Text="—" FontSize="16" Foreground="#e2e8f0" FontFamily="Consolas" HorizontalAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="BATTERY" FontSize="8" Foreground="#4a5568" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Name="HudBatt" Text="—" FontSize="16" Foreground="#e2e8f0" FontFamily="Consolas" HorizontalAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="MODE" FontSize="8" Foreground="#4a5568" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Name="HudMode" Text="—" FontSize="16" Foreground="#0d9e75" FontFamily="Consolas" HorizontalAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="GPS" FontSize="8" Foreground="#4a5568" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Name="HudGps" Text="—" FontSize="16" Foreground="#e2e8f0" FontFamily="Consolas" HorizontalAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="LAT / LON" FontSize="8" Foreground="#4a5568" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Name="HudPos" Text="—" FontSize="10" Foreground="#e2e8f0" FontFamily="Consolas" HorizontalAlignment="Center"/>
      </StackPanel>
    </Grid>

    <!-- Waypoint list -->
    <Border Grid.Row="3" Background="#1a2637" MaxHeight="150"
            BorderBrush="#1e3a5f" BorderThickness="0,1,0,0">
      <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="16,8,16,4">
          <TextBlock Text="WAYPOINTS" FontSize="9" FontWeight="Bold" Foreground="#4a5568" LetterSpacing="1" VerticalAlignment="Center"/>
          <TextBlock Name="WpCount" Text="0 points" FontSize="11" Foreground="#64748b" VerticalAlignment="Center"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
          <ItemsControl Name="WaypointList" Margin="8,0,8,8">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

  </Grid>
</UserControl>
