<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InfraDroneDesktop.MainWindow"
        Title="InfraDrone GCS — DAMbv"
        Width="1600" Height="960"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppWindowBg}">

  <Grid ColumnDefinitions="180,*">

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="{DynamicResource AppSidebarBg}"
            BorderBrush="{DynamicResource AppSidebarBorder}" BorderThickness="0,0,1,0">
      <DockPanel>
        <Button DockPanel.Dock="Bottom" Content="🔌  Connect" Classes="nav-connect" Click="OnConnect"
                Margin="8" HorizontalAlignment="Stretch"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>

        <!-- Brand -->
        <StackPanel Margin="10,10,10,8">
          <TextBlock Text="✈ InfraDrone" FontSize="14" FontWeight="Bold"
                     Foreground="{DynamicResource AppBrandFg}"/>
          <TextBlock Text="DAMbv GCS" FontSize="11" Foreground="#64748b"/>
        </StackPanel>
        <Button Name="BtnPrepareDemo" Content="🚀  Prepare Demo" Click="OnPrepareDemo"
                Margin="8,0,8,10" HorizontalAlignment="Stretch"
                Background="#0d3d2e" Foreground="#0d9e75" BorderThickness="0.5"
                BorderBrush="#0d9e75" Padding="8,6" CornerRadius="6"/>
        <Button Name="BtnToggleTheme" Content="☀ Light mode" Click="OnToggleTheme"
                Margin="8,0,8,10" HorizontalAlignment="Stretch"
                Background="Transparent" Foreground="{DynamicResource AppNavFg}"
                BorderThickness="0.5" BorderBrush="{DynamicResource AppSidebarBorder}"
                Padding="8,6" CornerRadius="6"/>

        <!-- Status Panel -->
        <Border Margin="6" Background="#0f1923" CornerRadius="6" Padding="8">
          <StackPanel>
            <TextBlock Text="AIRCRAFT STATUS" FontSize="9" FontWeight="Bold"
                       Foreground="#4a5568" LetterSpacing="1" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
              <Ellipse Width="8" Height="8" Fill="#ef4444" Margin="0,0,6,0"
                       Name="ConnDot"/>
              <TextBlock Name="ConnText" Text="Offline" FontSize="11"
                         Foreground="#94a3b8"/>
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
              <TextBlock Text="Mode" FontSize="11" Foreground="#64748b"/>
              <TextBlock Name="ModeText" Text="—" FontSize="11"
                         Foreground="#e2e8f0" Grid.Column="1" FontFamily="Consolas"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
              <TextBlock Text="Battery" FontSize="11" Foreground="#64748b"/>
              <TextBlock Name="BattText" Text="—" FontSize="11"
                         Foreground="#e2e8f0" Grid.Column="1" FontFamily="Consolas"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
              <TextBlock Text="GPS" FontSize="11" Foreground="#64748b"/>
              <TextBlock Name="GpsText" Text="—" FontSize="11"
                         Foreground="#e2e8f0" Grid.Column="1" FontFamily="Consolas"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Nav -->
        <Expander Header="FLIGHT OPS" Classes="navgroup" IsExpanded="True">
          <StackPanel>
            <Button Content="✈  Mission Planner" Classes="nav" Click="OnFlightView"/>
            <Button Content="🧪  MAVLink Test" Classes="nav" Click="OnMavLinkTestView"/>
            <Button Content="🛡  Failsafe Monitor" Classes="nav" Click="OnFailsafeMonitorView"/>
            <Button Content="☑  Pre-flight check" Classes="nav" Click="OnPreflightView"/>
            <Button Content="🎯  Calibration" Classes="nav" Click="OnCalibrationView"/>
            <Button Content="🌤  Weather" Classes="nav" Click="OnWeatherView"/>
          </StackPanel>
        </Expander>

        <Expander Header="INFRASTRUCTURE" Classes="navgroup" IsExpanded="True">
          <StackPanel>
            <Button Content="🌍  Land &amp; Environment" Classes="nav" Click="OnLandEnvironmentView"/>
            <Button Content="📈  Asset Intelligence" Classes="nav" Click="OnAssetIntelligenceView"/>
            <Button Content="☀  Solar Inspection" Classes="nav" Click="OnSolarInspectionView"/>
            <Button Content="🦌  Wildlife Survey" Classes="nav" Click="OnWildlifeSurveyView"/>
            <Button Content="🤖  AI" Classes="nav" Click="OnAiView"/>
            <Button Content="🗺  Survey &amp; Processing" Classes="nav" Click="OnSurveyAndProcessingView"/>
            <Button Content="🚦  Traffic Intelligence" Classes="nav" Click="OnTrafficIntelligenceView"/>
          </StackPanel>
        </Expander>

        <Expander Header="AGRICULTURE" Classes="navgroup" IsExpanded="True">
          <StackPanel>
            <Button Content="🌿  Sequoia Capture" Classes="nav" Click="OnSequoiaView"/>
            <Button Content="🌱  Nitrogen Zones" Classes="nav" Click="OnNitrogenZonesView"/>
            <Button Content="🔬  Validation &amp; Evidence" Classes="nav" Click="OnValidationView"/>
          </StackPanel>
        </Expander>

        <Expander Header="SYSTEM" Classes="navgroup" IsExpanded="False">
          <StackPanel>
            <Button Content="🏔  Terrain" Classes="nav" Click="OnTerrainView"/>
            <Button Content="⬡  Geofence" Classes="nav" Click="OnGeofenceView"/>
            <Button Content="⚙  Parameters" Classes="nav" Click="OnParamsView"/>
            <Button Content="🚁  Bluegrass Params" Classes="nav" Click="OnBluegrassParamsView"/>
            <Button Content="📋  Audit log" Classes="nav" Click="OnAuditView"/>
            <Button Content="🚁  DJI Tools" Classes="nav" Click="OnDjiView"/>
            <Button Content="🔑  License" Classes="nav" Click="OnParamsViewLicense"/>
          </StackPanel>
        </Expander>

      </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Main content -->
    <Border Grid.Column="1" Name="ContentArea">
      <TextBlock Text="Select a view from the sidebar"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="#4a5568" FontSize="14"/>
    </Border>

  </Grid>
</Window>
